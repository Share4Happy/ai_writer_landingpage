# Production Site URL (dùng cho Canonical, Open Graph, Sitemap)
VITE_SITE_URL=https://username.github.io/toolwriteseo

# Base path deploy (ví dụ: '/toolwriteseo/' cho repo thường, '/' cho root domain)
VITE_BASE_PATH=/toolwriteseo/

# WordPress REST API Config
VITE_WP_API_URL=https://share4happy.com/wp-json/wp/v2/posts
VITE_WP_CATEGORY_ID=208
VITE_WP_POSTS_COUNT=5

# Google Form Action URL (Form: Tool Viết bài)
VITE_GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/1FAIpQLSfU8mUDgnxzP6xs50LBUCgVbeR9o0D6evM3sQwZyXCYQzyM9Q/formResponse

# Invoice & Email API (Endpoint tạo hoá đơn & gửi email)
VITE_INVOICE_API_URL=
VITE_INVOICE_API_KEY=

# Zalo Bot Gateway API Config (Nhắn tin & kết bạn tự động)
VITE_ZALO_API_BASE_URL=
VITE_ZALO_BOT_ID=
VITE_ZALO_API_KEY=
