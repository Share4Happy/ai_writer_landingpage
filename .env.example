# Production Site URL (dùng cho Canonical, Open Graph, Sitemap)
VITE_SITE_URL=https://your-domain.com

# Base path deploy (ví dụ: '/' cho custom domain / root domain, '/tool_ai_writer/' cho repo thường)
VITE_BASE_PATH=/

# Dev Server Port (mặc định: 3000)
VITE_DEV_PORT=3000

# Google Form Action URL - Lấy từ Google Form của bạn
# Hướng dẫn: https://github.com/toperkin/staticFormEmails
VITE_GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse

# Invoice API - Hệ thống hoá đơn (nếu có)
VITE_INVOICE_API_URL=https://your-invoice-api.com/api/invoices/quick-create
VITE_INVOICE_API_KEY=your_api_key_here

# WordPress REST API (tùy chọn - lấy bài viết động)
VITE_WP_API_URL=https://your-wordpress-site.com/wp-json/wp/v2/posts
VITE_WP_CATEGORY_ID=1
VITE_WP_POSTS_COUNT=5

